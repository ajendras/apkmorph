[llm]
default_model = "llama3.2"
auto_download = true
temperature = 0.15

[tools]
apktool = "apktool"

[signing]
use_debug = true
keystore = "~/.android/debug.keystore"

[paths]
working_dir = "decompiled"
build_dir = "builds"

[ui]
port = 8501

[analysis]
max_strings = 250

[frida]
duration = 10
auto_observe = true

[gallery]
enabled = true
show_confidence = true
default_templates = ["remove_ads", "disable_analytics", "dark_theme"]
